{
  "entrypoint": {
    "input_path": "inputs/samples/easy_1.wav",
    "output_path": "outputs",
    "sample_rate": 16000
  },
  "runtime": {
    "dry_run": false
  },
  "logging": {
    "log_dir": "logs",
    "progress_bar": true
  },
  "vad": {
    "backend": "silero",
    "model": "silero_vad",
    "threshold": 0.2,
    "min_duration_seconds": 0.15,
    "merge_gap_seconds": 0.2
  },
  "diarization": {
    "backend": "sortformer",
    "model": "nvidia/diar_sortformer_4spk-v1",
    "token_env": "HUGGINGFACE_TOKEN",
      "device": "auto",
      "num_speakers": 2,
      "nemo_log_level": "ERROR",
    "min_duration_seconds": 0.25,
    "max_chunk_seconds": 120.0,
    "min_silence_seconds": 0.3,
    "speaker_link_threshold": 0.75
  },
  "asr": {
    "_model_replacement_comment": "Change model to replace ASR model. Keep backend=phowhisper_local for local PhoWhisper-compatible Transformers models.",
    "enabled": false,
    "backend": "phowhisper_local",
    "model": "vinai/PhoWhisper-large",
    "language": "vi",
    "device": "auto",
    "chunk_length_seconds": 30.0
  },
  "state_labeling": {
    "_model_replacement_comment": "Change model to replace the Qwen/OpenAI-compatible state-labeling model.",
    "enabled": false,
    "backend": "qwen",
    "model": "qwen3.8-max",
    "base_url": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
    "api_key_env": "DASHSCOPE_API_KEY",
    "state_dir": "state",
    "labels": [
      "complete",
      "incomplete"
    ]
  },
  "export": {
    "write_segment_wavs": false,
    "write_visualizations": false
  },
  "overlap": {
    "threshold_seconds": 0.05
  },
  "music_separation": {
    "_model_replacement_comment": "Change model to replace Demucs music separation model, for example htdemucs or another model supported by demucs.pretrained.get_model.",
    "enabled": false,
    "backend": "demucs",
    "model": "htdemucs",
    "device": "auto",
    "shifts": 1,
    "split": true,
    "overlap": 0.25,
    "residual_subtract": 0.5
  },
  "overlap_separation": {
    "enabled": true,
    "backend": "sepreformer",
    "model_name": "SepReformer_Base_WSJ0",
    "device": "auto",
    "overlap_threshold_seconds": 1.0,
    "speaker_embedding_model": "pyannote/embedding",
    "speaker_embedding_min_seconds": 0.5
  }
}
